*.metallib
*.mo
.mypy_cache/
# Node.js — no trailing slash: `node_modules/` only matches directories, so a
# dev-convenience SYMLINK named node_modules (worktree setups) evades it and
# gets committed, breaking CI's `pnpm install` with ENOTDIR on checkout.
node_modules
nosetests.xml
.nox/
npm-debug.log*
packages/luxar/src/luxar/demos/legends/
packages/luxar/src/luxar/gsplats/models/gsplats/metal/packages/
