{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "dist/lib/types",
    "rootDir": "src"
  },
  "include": ["src/index.ts", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "node_modules",
    "dist",
    "src/tests",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/core/main.ts",
    "src/core/control-panel/main.ts",
    "src/lib-styles-entry.ts"
  ]
}
