# WASM build output — wasm-pack owns this dir and overwrites everything in it
# on each build (including copying the crate README over any README placed
# here), so nothing inside is trackable. See src/wasm/README.md instead.
public/wasm/
viewer_code_reviews/

# Generated TypeDoc output
docs/

# Per-machine performance baselines (test self-rewrites this on every
# passing run; should not be tracked across hardware).
performance-baselines.json
points-rendering-perf.json
line-renderer-compare-perf.json
test-results-perf/

# Line perf-bench writes per-commit results to perf-results/<sha>/...
# Keep the README (it's the directory's docs) but ignore generated runs.
perf-results/*
!perf-results/README.md

# Stryker mutation testing: sandbox + generated HTML report. The config
# (stryker.conf.json) is tracked; its output is not.
.stryker-tmp/
reports/mutation/
