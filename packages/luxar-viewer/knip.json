{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/core/main.ts",
    "src/index.ts",
    "src/lib-styles-entry.ts",
    "src/tests/**/*.{test,spec}.ts",
    "src/tests/e2e/harnesses/*.ts",
    "scripts/**/*.{ts,mjs,js}",
    "tools/**/*.ts",
    "tests/fixtures/**/*.{ts,py}"
  ],
  "project": ["src/**/*.ts"],
  "ignore": [
    "src/rendering/picking/index.ts",
    "src/rendering/shaders/index.ts",
    "src/types/index.ts",
    "src/types/format-contract.ts",
    "typedoc.json",
    "src/tests/builders/**",
    "src/tests/e2e/helpers.ts",
    "src/tests/test-config.ts"
  ],
  "ignoreBinaries": ["hatch"],
  "ignoreExportsUsedInFile": true,
  "tags": ["-internal"]
}
