{
  "name": "@luxar/viewer",
  "version": "2026.6.5",
  "description": "GPU-accelerated WebGL renderer for nD scientific datasets",
  "license": "BSD-3-Clause",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "author": "Loic A. Royer and Luxar Contributors",
  "homepage": "https://luxarviewer.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/royerlab/luxar.git",
    "directory": "packages/luxar-viewer"
  },
  "bugs": {
    "url": "https://github.com/royerlab/luxar/issues"
  },
  "keywords": [
    "webgl",
    "zarr",
    "scientific-visualization",
    "3d-rendering",
    "ndarray",
    "gaussian-splats",
    "microscopy",
    "image-viewer",
    "hdr",
    "three",
    "visualization"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.6.0"
  },
  "packageManager": "pnpm@10.34.5",
  "main": "./dist/lib/luxar-viewer.js",
  "module": "./dist/lib/luxar-viewer.js",
  "types": "./dist/lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/types/index.d.ts",
      "import": "./dist/lib/luxar-viewer.js"
    },
    "./styles.css": "./dist/lib/luxar-viewer.css"
  },
  "files": [
    "dist/lib/**",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/lib/luxar-viewer-styles.js"
  ],
  "peerDependencies": {
    "three": "~0.185.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:wasm && tsc --project tsconfig.build.json && vite build && pnpm build:check",
    "build:check": "node scripts/check-eager-chunks.mjs",
    "build:lib": "pnpm build:wasm && vite build --config vite.lib.config.ts && tsc --project tsconfig.lib.json",
    "build:lib:check": "node scripts/check-lib-exports.mjs",
    "build:wasm": "bash scripts/build-wasm.sh",
    "build:wasm:dev": "bash scripts/build-wasm.sh --dev",
    "test:wasm": "cd src/wasm/rust && cargo test",
    "bench:wasm": "tsx src/tests/benchmarks/wasm-benchmark.ts",
    "preview": "vite preview",
    "test:generate-fixtures": "cd ../.. && hatch run fixtures:python packages/luxar-viewer/tests/fixtures/generate_test_data.py && hatch run fixtures:python packages/luxar-viewer/tests/fixtures/generate_expectations.py && cd packages/luxar-viewer && tsx tools/fixture-freshness.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "pnpm dlx --package=@stryker-mutator/core@10.0.0 --package=@stryker-mutator/vitest-runner@10.0.0 stryker run",
    "test:perf": "vitest --run --config vitest.perf.config.ts",
    "test:perf:strict": "LUXAR_PERF_QUIET_HOST=1 vitest --run --config vitest.perf.config.ts",
    "bench:zip:fixtures": "cd ../.. && hatch run python packages/luxar-viewer/tools/make-zip-bench-fixtures.py \"${LUXAR_BENCH_FIXTURES:-packages/luxar-viewer/bench-fixtures}\"",
    "bench:zip": "playwright test --config playwright.zipbench.config.ts",
    "test:perf:e2e": "LUXAR_E2E_NO_FIXTURES=1 playwright test --config playwright.perf.config.ts",
    "perf:diff": "node scripts/perf-diff.mjs",
    "test:watch": "vitest --watch",
    "test:with-fixtures": "pnpm test:generate-fixtures && pnpm test",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --grep-invert '@visual' --retries 2",
    "test:e2e:visual": "node -e \"if(process.platform!=='linux'){console.error('Visual baselines are Linux-only.');process.exit(1)}\" && playwright test --grep '@visual'",
    "test:e2e:visual:update": "node -e \"if(process.platform!=='linux'){console.error('Visual baselines are Linux-only.');process.exit(1)}\" && playwright test --grep '@visual' --update-snapshots=all",
    "test:e2e:smoke": "LUXAR_E2E_NO_FIXTURES=1 playwright test viewer-initialization.spec.ts url-parameters.spec.ts dataset-switching.spec.ts controls-interaction.spec.ts keyboard-input-system.spec.ts --retries 2 --timeout 60000",
    "test:e2e:smoke:strict": "LUXAR_E2E_NO_FIXTURES=1 LUXAR_E2E_STRICT_CONSOLE=1 playwright test viewer-initialization.spec.ts url-parameters.spec.ts dataset-switching.spec.ts controls-interaction.spec.ts keyboard-input-system.spec.ts --retries 2 --timeout 60000",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "readme-images": "playwright test --config playwright.screenshots.config.ts generate-readme-images",
    "gallery": "playwright test --config playwright.gallery.config.ts",
    "doc-images": "playwright test --config playwright.screenshots.config.ts generate-doc-images",
    "agent:debug": "tsx tools/agent-driver.ts",
    "agent:debug:visible": "tsx tools/agent-driver.ts --headless=false",
    "typedoc": "typedoc",
    "typedoc:check-warnings": "node scripts/check-typedoc-warnings.mjs",
    "test:typedoc-warnings": "node --test scripts/check-typedoc-warnings-tests.mjs",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc.tsbuildinfo",
    "lint": "eslint src --ext .ts,.tsx --cache --cache-location node_modules/.cache/.eslintcache --pass-on-unpruned-suppressions",
    "check:layers": "depcruise src --config .dependency-cruiser.cjs",
    "check:overrides": "node scripts/check-overrides.mjs",
    "check:knip": "knip --no-progress --no-config-hints",
    "check:knip:ci": "knip --no-progress --no-config-hints --include files,dependencies",
    "format": "prettier --write --cache --cache-strategy content src",
    "check:format": "prettier --check --cache --cache-strategy content src",
    "check": "pnpm run check:format && pnpm run typecheck && pnpm run lint && pnpm test --run",
    "check:static": "pnpm run check:overrides && pnpm run check:format && pnpm run typecheck && pnpm run lint && pnpm run check:layers && pnpm run check:knip:ci",
    "check:coverage-slack": "node scripts/check-coverage-slack.mjs",
    "check:ci": "pnpm run check:static && pnpm run test:coverage && pnpm run check:coverage-slack",
    "ci:release": "pnpm run build:lib && pnpm run build:lib:check"
  },
  "dependencies": {
    "@zarrita/storage": "^0.2.0",
    "comlink": "^4.4.2",
    "fflate": "^0.8.3",
    "mediabunny": "^1.55.2",
    "zarrita": "^0.7.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.3.0",
    "@types/three": "~0.185.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitest/coverage-v8": "~4.1.10",
    "@vitest/ui": "~4.1.10",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.9.1",
    "fast-check": "^4.9.0",
    "glob": "^13.0.6",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "knip": "^6.32.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typedoc": "^0.28.20",
    "typescript": "~5.9.3",
    "vite": "~8.2.2",
    "vitest": "~4.1.10"
  }
}
