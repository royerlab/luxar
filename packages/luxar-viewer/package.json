{
  "name": "luxar-viewer",
  "version": "0.0.1",
  "description": "GPU-accelerated WebGL renderer for nD scientific datasets",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --project tsconfig.build.json && vite build",
    "preview": "vite preview",
    "test:generate-fixtures": "cd ../.. && hatch run python packages/luxar-viewer/tests/fixtures/generate_test_data.py",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch",
    "test:with-fixtures": "pnpm test:generate-fixtures && pnpm test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "agent:debug": "ts-node tools/agent-driver.ts",
    "agent:debug:visible": "ts-node tools/agent-driver.ts --headless=false",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write src",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "postprocessing": "^6.38.0",
    "three": "^0.163.0",
    "zarrita": "^0.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.1",
    "@types/stats.js": "^0.17.4",
    "@types/three": "^0.178.1",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "@zarrita/storage": "^0.1.3",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "jsdom": "^24.1.3",
    "prettier": "^3.6.2",
    "stats.js": "^0.17.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^3.2.4"
  }
}
