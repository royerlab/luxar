{
  "name": "luxar-viewer",
  "version": "2025.8.3",
  "description": "GPU-accelerated WebGL renderer for nD scientific datasets",
  "license": "BSD-3-Clause",
  "author": "Loic A. Royer and Luxar Contributors",
  "homepage": "https://github.com/royerlab/luxar/tree/main/packages/luxar-viewer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/royerlab/luxar.git",
    "directory": "packages/luxar-viewer"
  },
  "bugs": {
    "url": "https://github.com/royerlab/luxar/issues"
  },
  "keywords": [
    "webgl",
    "zarr",
    "scientific-visualization",
    "3d-rendering",
    "ndarray",
    "gaussian-splats",
    "microscopy",
    "image-viewer",
    "hdr",
    "three",
    "visualization"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "ws@>=8.0.0 <8.20.1": ">=8.20.1",
      "brace-expansion@>=5.0.0 <5.0.6": ">=5.0.6"
    }
  },
  "main": "./dist/lib/luxar-viewer.js",
  "module": "./dist/lib/luxar-viewer.js",
  "types": "./dist/lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/types/index.d.ts",
      "import": "./dist/lib/luxar-viewer.js"
    },
    "./styles.css": "./dist/lib/luxar-viewer.css"
  },
  "files": [
    "dist/lib/**",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/lib/luxar-viewer-styles.js"
  ],
  "peerDependencies": {
    "three": "~0.184.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:wasm && tsc --project tsconfig.build.json && vite build",
    "build:lib": "pnpm build:wasm && vite build --config vite.lib.config.ts && tsc --project tsconfig.lib.json",
    "build:lib:check": "node scripts/check-lib-exports.mjs",
    "build:wasm": "bash scripts/build-wasm.sh",
    "build:wasm:dev": "bash scripts/build-wasm.sh --dev",
    "test:wasm": "cd src/wasm/rust && cargo test",
    "bench:wasm": "tsx src/tests/benchmarks/wasm-benchmark.ts",
    "preview": "vite preview",
    "test:generate-fixtures": "cd ../.. && hatch run python packages/luxar-viewer/tests/fixtures/generate_test_data.py && hatch run python packages/luxar-viewer/tests/fixtures/generate_expectations.py",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:perf": "vitest --run --config vitest.perf.config.ts",
    "test:perf:e2e": "playwright test --config playwright.perf.config.ts",
    "perf:diff": "node scripts/perf-diff.mjs",
    "test:watch": "vitest --watch",
    "test:with-fixtures": "pnpm test:generate-fixtures && pnpm test",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --grep-invert '@visual' --retries 2",
    "test:e2e:smoke": "playwright test viewer-initialization.spec.ts url-parameters.spec.ts dataset-switching.spec.ts controls-interaction.spec.ts keyboard-input-system.spec.ts --retries 2 --timeout 60000",
    "test:e2e:smoke:strict": "LUXAR_E2E_STRICT_CONSOLE=1 playwright test viewer-initialization.spec.ts url-parameters.spec.ts dataset-switching.spec.ts controls-interaction.spec.ts keyboard-input-system.spec.ts --retries 2 --timeout 60000",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "readme-images": "playwright test --config playwright.screenshots.config.ts generate-readme-images",
    "readme-videos": "playwright test --config playwright.videos.config.ts",
    "doc-images": "playwright test --config playwright.screenshots.config.ts generate-doc-images",
    "agent:debug": "tsx tools/agent-driver.ts",
    "agent:debug:visible": "tsx tools/agent-driver.ts --headless=false",
    "typedoc": "typedoc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "check:layers": "depcruise src --config .dependency-cruiser.cjs",
    "check:knip": "knip --no-progress --no-config-hints",
    "check:knip:ci": "knip --no-progress --no-config-hints --include files,dependencies",
    "format": "prettier --write src",
    "check": "pnpm run typecheck && pnpm run lint && pnpm test --run",
    "check:ci": "pnpm run typecheck && pnpm run lint && pnpm run check:layers && pnpm run check:knip:ci && pnpm run test:coverage",
    "ci:release": "pnpm run build:lib && pnpm run build:lib:check"
  },
  "dependencies": {
    "comlink": "^4.4.2",
    "fflate": "^0.8.2",
    "mediabunny": "^1.44.2",
    "zarrita": "^0.7.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.10.1",
    "@types/stats.js": "^0.17.4",
    "@types/three": "~0.184.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitest/coverage-v8": "~4.1.5",
    "@vitest/ui": "~4.1.5",
    "@zarrita/storage": "^0.2.0",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9.39.4",
    "fast-check": "^4.8.0",
    "globals": "^16.5.0",
    "jsdom": "^24.1.3",
    "knip": "^6.12.1",
    "prettier": "^3.8.3",
    "stats.js": "^0.17.0",
    "tsx": "^4.21.0",
    "typedoc": "^0.28.19",
    "typescript": "~5.9.3",
    "vite": "~8.0.5",
    "vitest": "~4.1.5"
  }
}
