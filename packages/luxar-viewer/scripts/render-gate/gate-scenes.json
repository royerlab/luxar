          "metrics": [
            { "name": "achievedFps", "better": "higher", "kind": "timing" },
            { "name": "render.count", "better": "lower", "kind": "counter", "relTol": 0.05 },
            { "name": "lastTimepointShown", "better": "higher", "kind": "counter" },
            { "name": "lod.levelSwaps", "better": "lower", "kind": "counter", "relTol": 0.05 },
            { "name": "decode.duplicates", "better": "lower", "kind": "counter" }
          ]
