      "defaults": {
        "rounds": 5,
        "backends": ["webgl", "webgpu"],
        "viewport": { "width": 960, "height": 540 },
        "dsf": 1,
        "urlParams": "noBlendWarmup",
        "serverProfile": "local"
      },
      "cases": [
        {
          "id": "playback_tp50",
          "store": "gate/tp50.luxar.zarr",
          "workload": { "kind": "playback", "fps": 10, "durationMs": 6000 },
          "metrics": [
            { "name": "gpu.uploadBytes", "better": "lower", "kind": "counter", "relTol": 0.05 },
            { "name": "achievedFps", "better": "higher", "kind": "timing" },
            { "name": "render.count", "better": "lower", "kind": "counter", "relTol": 0.05 },
            { "name": "lastTimepointShown", "better": "higher", "kind": "counter" },
            { "name": "decode.duplicates", "better": "lower", "kind": "counter" },
            { "name": "console.calls", "better": "lower", "kind": "counter", "relTol": 0.05 }
          ]
        },
