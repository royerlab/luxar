[flake8]
# Align with black line length
max-line-length = 88

# Black compatibility
extend-ignore = E203,E501,W503

# Exclude common directories
exclude = 
    .git,
    __pycache__,
    build,
    dist,
    .eggs,
    *.egg,
    .venv,
    venv,
    .tox,
    .mypy_cache,
    .pytest_cache,
    htmlcov,
    node_modules,
    .idea,
    .vscode

# Per-file ignores
per-file-ignores = 
    __init__.py:F401

# McCabe complexity
max-complexity = 12