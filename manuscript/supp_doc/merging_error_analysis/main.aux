\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Inter-splat cosine similarity vs.\ normalised separation for two splats with equal isotropic covariances $\bm  {\Sigma }_1 = \bm  {\Sigma }_2 = \sigma ^2\bm  {I}$. The result $\cos \theta = \exp (-d^2/4\sigma ^2)$ is independent of the dimension~$D$: the $2^{D/2}$ prefactor in~\eqref  {eq:cosine} exactly cancels the determinant ratio for equal covariances. The shaded region ($d \lesssim 2\sigma $, $\cos \theta \gtrsim e^{-1}$) indicates practically mergeable pairs.}}{9}{figure.caption.11}\protected@file@percent }
\newlabel{fig:cosine_vs_distance}{{5}{9}{Inter-splat cosine similarity vs.\ normalised separation for two splats with equal isotropic covariances $\Sig _1 = \Sig _2 = \sigma ^2\bm {I}$. The result $\cos \theta = \exp (-d^2/4\sigma ^2)$ is independent of the dimension~$D$: the $2^{D/2}$ prefactor in~\eqref {eq:cosine} exactly cancels the determinant ratio for equal covariances. The shaded region ($d \lesssim 2\sigma $, $\cos \theta \gtrsim e^{-1}$) indicates practically mergeable pairs}{figure.caption.11}{}}
\newlabel{fig:cosine_vs_distance@cref}{{[figure][5][]5}{[1][9][]9}}
