\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Geometric interpretation in $L^2$. The mixture $f = \phi _1 + \phi _2$ is a vector in the Hilbert space. Its projection onto the ray spanned by~$\bar  {G}$ (the unit-amplitude template) gives the optimal amplitude $a^*\bar  {G}$. The residual $r = f - a^*\bar  {G}$ is orthogonal to~$\bar  {G}$, and the normalised squared residual is $\varepsilon = \sin ^2\!\alpha $.}}{7}{figure.caption.8}\protected@file@percent }
\newlabel{fig:angle_diagram}{{4}{7}{Geometric interpretation in $L^2$. The mixture $f = \phi _1 + \phi _2$ is a vector in the Hilbert space. Its projection onto the ray spanned by~$\bar {G}$ (the unit-amplitude template) gives the optimal amplitude $a^*\bar {G}$. The residual $r = f - a^*\bar {G}$ is orthogonal to~$\bar {G}$, and the normalised squared residual is $\varepsilon = \sin ^2\!\alpha $}{figure.caption.8}{}}
\newlabel{fig:angle_diagram@cref}{{[figure][4][]4}{[1][7][]7}}
